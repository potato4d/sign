{
  "name": "sign",
  "productName": "sign",
  "version": "0.3.4",
  "license": "MIT",
  "description": "A secure Electron and TypeScript desktop application foundation.",
  "main": "./out/main/index.js",
  "private": true,
  "engines": {
    "node": ">=24",
    "npm": ">=11"
  },
  "packageManager": "npm@11.11.0",
  "overrides": {
    "dompurify": "3.4.12"
  },
  "scripts": {
    "start": "electron-vite dev",
    "preview": "electron-vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit -p tsconfig.main.json && tsc --noEmit -p tsconfig.renderer.json",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test",
    "build": "electron-vite build",
    "package": "npm run check && npm run build && node scripts/package.mjs"
  },
  "devDependencies": {
    "@electron/fuses": "2.1.3",
    "@electron/packager": "20.0.4",
    "@eslint/js": "10.0.1",
    "@types/node": "24.13.3",
    "electron": "43.2.0",
    "electron-vite": "5.0.0",
    "eslint": "10.0.1",
    "globals": "17.8.0",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0",
    "vite": "7.3.6",
    "vitest": "4.1.10"
  },
  "dependencies": {
    "monaco-editor": "0.56.0"
  }
}
